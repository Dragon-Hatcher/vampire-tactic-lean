  | .structInductionAxiomThree => "struct_induction_axiom_three"
  | .structInductionAxiomRecursion => "struct_induction_axiom_recursion"
  | .intInfUpInductionAxiom => "int_inf_up_induction_axiom"
  | .intInfDownInductionAxiom => "int_inf_down_induction_axiom"
  | .intFinUpInductionAxiom => "int_fin_up_induction_axiom"
  | .intFinDownInductionAxiom => "int_fin_down_induction_axiom"
  | .intDbUpInductionAxiom => "int_db_up_induction_axiom"
  | .intDbDownInductionAxiom => "int_db_down_induction_axiom"
  | .functionalExtensionalityAxiom => "functional_extensionality_axiom"

instance : ToString InferenceRule := ⟨name⟩

/-- The rule vampire numbers `i`. -/
def ofNat? (i : Nat) : Option InferenceRule := all[i]?

